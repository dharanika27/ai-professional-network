{
  "name": "ai-professional-network",
  "description": "An AI-powered professional networking platform inspired by LinkedIn that helps users build professional profiles, connect with other professionals, share content, discover jobs, and receive AI-powered career assistance. Integrates Agentic AI, LLMs, RAG, and intelligent workflows for resume review, profile optimization, interview preparation, job matching, and career coaching.",
  "stack": {
    "backend": {
      "language": "python",
      "version": "3.12",
      "framework": "fastapi",
      "package_manager": "uv",
      "linter": "ruff",
      "typechecker": "mypy",
      "test_runner": "pytest"
    },
    "frontend": {
      "language": "typescript",
      "version": "5",
      "framework": "react",
      "build_tool": "vite",
      "package_manager": "npm",
      "linter": "eslint",
      "typechecker": "tsc",
      "test_runner": "vitest"
    },
    "database": {
      "primary": "postgresql",
      "secondary": "pgvector"
    },
    "deployment": {
      "method": "docker-compose",
      "services": ["backend", "frontend", "postgres"]
    }
  },
  "evaluation": {
    "api_base_url": "http://localhost:8000",
    "ui_base_url": "http://localhost:3000",
    "health_check": "http://localhost:8000/health",
    "design_score_threshold": 7,
    "design_max_iterations": 10,
    "test_corpus_dir": "specs/test_artefacts"
  },
  "execution": {
    "default_mode": "full",
    "max_self_heal_attempts": 3,
    "max_auto_iterations": 50,
    "coverage_threshold": 80,
    "session_chaining": true,
    "agent_team_size": "auto",
    "teammate_model": "sonnet"
  },
  "verification": {
    "mode": "local",
    "health_check": { "url": "http://localhost:3000/health", "retries": 5, "backoff_seconds": 2 },
    "local": {
      "backend_url": "http://localhost:8000",
      "frontend_url": "http://localhost:3000",
      "start_commands": [
        "cd backend && uv run uvicorn src.main:app --host 0.0.0.0 --port 8000",
        "cd frontend && npm run dev -- --port 3000"
      ]
    }
  }
}
